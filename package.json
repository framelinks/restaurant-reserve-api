  "description": "Restaurant Table Reservation API with real-time availability checking",
  "main": "server.js",
  "author": "Levyni Co (zionbrigde)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/framelinks/restaurant-reserve-api.git"
  },
  "bugs": {
